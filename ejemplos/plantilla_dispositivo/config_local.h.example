// config_local.h está en el .gitignore: NUNCA se commitea. Si contiene una clave,
// un AppKey o una MAC de producción y llega a GitHub, este repo es público.

#pragma once

// Mesh ESP-WIFI-MESH (interior): los datos los da la cátedra. El dispositivo es
// una HOJA: no lleva la clave del WiFi del edificio, solo la de la mesh.
#define MESH_ID     {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}
#define MESH_CLAVE  "CAMBIAR"
#define MESH_CANAL  0   // canal del WiFi del edificio; 0 = buscar en todos

// MAC de esta placa (herramientas/leer_mac). Es también su identidad en AURA:
// hw_id "mac-" + esta MAC en minúsculas.
#define MAC_ESPERADA {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}

// LoRaWAN: las credenciales OTAA las da la cátedra al dar de alta el dispositivo.
// #define LORAWAN_DEV_EUI  0x0000000000000000
// #define LORAWAN_JOIN_EUI 0x0000000000000000
// #define LORAWAN_APP_KEY  {0x00, ...}
