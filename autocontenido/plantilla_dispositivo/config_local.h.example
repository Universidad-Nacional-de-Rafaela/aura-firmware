#pragma once

// Mesh ESP-NOW: MAC del padre (nodo de sala, o el gateway si le llega directo),
// del gateway de la mesh (destino final) y de esta placa (herramientas/leer_mac).
#define MAC_PADRE    {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}
#define MAC_GATEWAY  {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}
#define MAC_ESPERADA {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}

