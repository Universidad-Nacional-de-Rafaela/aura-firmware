// Copiar este archivo como config_local.h (en la misma carpeta) y completar.
// config_local.h está en el .gitignore: NUNCA se commitea. Este repo es público:
// la clave del WiFi, las IP internas, los UUID y las MAC de producción van acá.

#pragma once

#define WIFI_SSID "CAMBIAR"
#define WIFI_PASS "CAMBIAR"

// Broker AURA y API. Si la máquina toma IP por DHCP puede cambiar y hay que reflashear.
#define MQTT_HOST "192.168.0.100"
#define MQTT_PORT 1883
#define API_BASE  "http://192.168.0.100:8000"
// #define API_TOKEN "..."   // cuando el endpoint REST pida autenticación (contrato §10)

#define TENANT_ID         "00000000-0000-0000-0000-000000000000"
#define GATEWAY_DEVICE_ID "00000000-0000-0000-0000-000000000000"   // el device_id de este gateway

// Si la red bloquea pool.ntp.org, el servidor NTP de la universidad.
#define NTP_SERVIDOR "pool.ntp.org"

// MAC de la placa en la que DEBE correr este sketch (herramientas/leer_mac).
#define MAC_ESPERADA {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}

// Tabla MAC -> device_id (contrato §2.4), una línea por nodo:
//   { MAC del nodo, device_id, type del evento REST, MAC del padre, comandos que acepta }
// Padre en cero: el nodo le llega directo al gateway. Comandos separados por
// coma, sin espacios; "" = ninguno (la sala no tiene comandos).
#define TABLA_NODOS { \
  { {0x00,0x00,0x00,0x00,0x00,0x00}, "00000000-0000-0000-0000-000000000001", "temperatura", \
    {0x00,0x00,0x00,0x00,0x00,0x00}, "set_config" }, \
  { {0x00,0x00,0x00,0x00,0x00,0x00}, "00000000-0000-0000-0000-000000000002", "sala", \
    {0x00,0x00,0x00,0x00,0x00,0x00}, "" }, \
}
