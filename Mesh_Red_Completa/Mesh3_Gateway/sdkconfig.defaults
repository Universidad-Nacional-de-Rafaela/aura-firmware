# ESP32-S3 N32R16V (flash octal 32 MB) - Gateway
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# Tabla propia: dos lugares OTA para sí mismo y la partición "imagen" que reparte por la malla
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Una versión nueva que no logra conectarse al broker vuelve sola a la anterior
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
