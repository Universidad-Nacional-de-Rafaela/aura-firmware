#pragma once

// MAC (STA) de la enroladora de tarjetas (herramientas/enrolador_puerta): es la única placa
// que puede mandarle órdenes a la puerta. Se lee en el monitor serie de la enroladora al arrancar.
#define MAC_ENROLADOR_BYTES {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}

// Claves de ESP-NOW: 16 caracteres exactos, inventadas por vos, y las mismas que en el
// config_local.h de la enroladora.
#define ESPNOW_PMK "CAMBIAR-PMK-0000"
#define ESPNOW_LMK "CAMBIAR-LMK-0000"
