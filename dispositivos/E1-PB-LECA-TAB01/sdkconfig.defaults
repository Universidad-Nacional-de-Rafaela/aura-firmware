# ESP32-C3 SuperMini (4 MB) - Hoja
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Tabla propia: app + partición "cola" (respaldo de mediciones sin confirmar tras un corte)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Consola por el USB del chip (la SuperMini no tiene conversor USB-serie). Así la UART0
# no usa los pines 20 y 21, que son del RS-485 del medidor.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
